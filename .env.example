# Database
# - Dev lokal: kosongkan / pakai file:./data/app.db  -> SQLite via node:sqlite (tanpa setup)
# - Production (Vercel + Neon): isi dengan connection string Postgres dari Neon,
#   mis. postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
#   -> backend otomatis beralih ke PostgreSQL
DATABASE_URL=

# Secret untuk sign session cookie admin (wajib diganti di production!)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# URL publik situs (dipakai sitemap & metadata). Wajib di-set di production.
SITE_URL=http://localhost:3100

# Akun admin awal (dibuat oleh scripts/seed.ts). GANTI setelah login pertama.
ADMIN_EMAIL="admin@perpustakaan.local"
ADMIN_PASSWORD=admin123
